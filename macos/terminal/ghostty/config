# systemcmd - Ghostty ayarlari
# Kurulum: macos/install.sh bunu ~/.config/ghostty/config olarak kopyalar.
# Renkler `sc theme` ile uretilen systemcmd-theme dosyasindan gelir.

config-file = ?systemcmd-theme

# --- Yazi ---
font-family = JetBrainsMono Nerd Font
font-size = 14
font-thicken = true
adjust-cell-height = 10%

# --- Pencere ---
background-opacity = 0.93
background-blur = 24
window-padding-x = 16
window-padding-y = 12
window-padding-balance = true
window-save-state = always
macos-titlebar-style = tabs
macos-option-as-alt = true
unfocused-split-opacity = 0.8
confirm-close-surface = false
mouse-hide-while-typing = true
copy-on-select = clipboard

# --- Imlec ---
cursor-style = bar
cursor-style-blink = true

# --- Kabuk entegrasyonu (komut atlama, sudo, baslik) ---
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# --- Quick terminal: her yerden Alt+Space ile yukaridan iner ---
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-animation-duration = 0.12
keybind = global:alt+space=toggle_quick_terminal

# --- Bolmeler ---
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down

# --- Diger ---
keybind = cmd+shift+comma=reload_config
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1
